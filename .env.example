# ---- Server ----
PORT=3000
# Telefon (PWA) shu kalit bilan kiradi
API_KEY=telefon-uchun-maxfiy-kalit
# Kompyuterdagi agent shu kalit bilan ulanadi
AGENT_KEY=agent-uchun-maxfiy-kalit

# ---- POS tizimi (API qo'shilgach to'ldiring; bo'sh bo'lsa o'tkazib yuboriladi) ----
POS_URL=
POS_TOKEN=
POS_PRODUCTS_PATH=/api/products
# Mavjud tovarni yangilash: {id} o'rniga tashqi ID qo'yiladi
POS_UPDATE_PATH=/api/products/{id}

# ---- omborzaxirasi.online ----
OMBOR_URL=https://omborzaxirasi.online
OMBOR_TOKEN=
OMBOR_PRODUCTS_PATH=/api/products
OMBOR_UPDATE_PATH=/api/products/{id}

# ---- Etiketka (mm) ----
LABEL_WIDTH_MM=40
LABEL_HEIGHT_MM=30
